{
    "ConnectionStrings": {
        "ListedDatabase": "Host=postgresql;Port=5432;Database=listed;Username=postgres;Password=postgres",
        "Valkey": "valkey:6379,password=listed_valkey_local_password"
    },
    "Auth": {
        "SigningKey": "listed-signing-key-local-development-purposes-123456789"
    },
    "DataProtection": {
        "ApplicationName": "listed-api-docker",
        "KeyRingKey": "listed:dpkeys:docker",
        "CertificatePath": "",
        "CertificatePassword": ""
    },
    "Serilog": {
        "Using": [ "Serilog.Expressions", "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": {
                        "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                        "template": "[{UtcDateTime(@t):o} {@l:u3}] [CorrelationId:{CorrelationId}] {@m}\n{@x}"
                    }
                }
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq"
                }
            }
        ]
    }
}
