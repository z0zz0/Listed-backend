{
    "ConnectionStrings": {
        "DefaultConnection": "Host=postgresql;Port=5432;Database=listed;Username=postgres;Password=postgres"
    },
    "Serilog": {
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "Seq",
                "Args": {
                    "serverUrl": "http://seq",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] [CorrelationId:{CorrelationId}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    }
}
