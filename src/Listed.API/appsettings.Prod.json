{
    "ConnectionStrings": {
        "ListedDatabase": "Host=postgresql;Port=5432;Database=listed;Username=postgres;Password=postgres"
    },
    "Serilog": {
        "Using": [ "Serilog.Expressions", "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": {
                        "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                        "expression": "[{UtcDateTime(@t):o} {@l:u3}] [CorrelationId:{CorrelationId}] {@m}\n{@x}"
                    }
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "/logs/Listed-Prod-.log",
                    "rollingInterval": "Day",
                    "formatter": {
                        "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                        "template": "[{UtcDateTime(@t):o} {@l:u3}] [CorrelationId:{CorrelationId}] {@m}\n{@x}"
                    }
                }
            }
        ]
    }
}